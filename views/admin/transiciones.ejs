
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <title>Transiciones | FlowForge</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">
</head>

<body class="bg-light">

  <%- include('partials/header', { paginaActual: '/admin/transiciones' }) %>

<main class="container py-4">

    <h2>Administración de transiciones</h2>
    <p>Conecta las etapas de los procesos empresariales.</p>

    <section class="card p-4 mb-5">
      <form id="formTransicion">
        <input type="hidden" name="_csrf" value="<%= _csrf %>">
        <div class="mb-3">
          <label for="version" class="form-label">
            Versión del proceso
          </label>

          <select id="version" class="form-select" required>
            <option value="">Selecciona una versión</option>

            <% versiones.forEach(function(v) { %>
              <% if (v.estado === 'borrador') { %>
                <option value="<%= v.id %>">
                  <%= v.proceso ? v.proceso.nombre : 'Proceso' %>
                  - v<%= v.numero %>
                </option>
              <% } %>
            <% }); %>
          </select>
        </div>

        <div class="mb-3">
          <label for="nombre" class="form-label">
            Nombre de la transición
          </label>

          <input id="nombre"
                 class="form-control"
                 maxlength="100"
                 placeholder="Ej. Inicio a condición"
                 required>
        </div>

        <div class="mb-3">
          <label for="origen" class="form-label">
            Nodo de origen
          </label>

          <select id="origen" class="form-select" required disabled>
            <option value="">Selecciona primero una versión</option>
          </select>
        </div>

        <div class="mb-3">
          <label for="destino" class="form-label">
            Nodo de destino
          </label>

          <select id="destino" class="form-select" required disabled>
            <option value="">Selecciona primero una versión</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">
          Registrar transición
        </button>

      </form>
    </section>

    <section>
      <h3>Transiciones registradas</h3>

      <div class="table-responsive">
        <table class="table table-striped">

          <thead>
            <tr>
              <th>Nombre</th>
              <th>Versión</th>
              <th>Origen</th>
              <th>Destino</th>
            </tr>
          </thead>

          <tbody>
            <% transiciones.forEach(function(t) { %>
              <tr>
                <td><%= t.nombre %></td>
                <td>
                  <%= t.version ? 'v' + t.version.numero : '-' %>
                </td>
                <td><%= t.origen ? t.origen.nombre : '-' %></td>
                <td><%= t.destino ? t.destino.nombre : '-' %></td>
              </tr>
            <% }); %>
          </tbody>

        </table>
      </div>
    </section>

  </main>

    <script type="application/json" id="datosNodos">
        <%- JSON.stringify(nodos).replace(/</g, '\\u003c') %>
    </script>

  <script>
    // Datos proporcionados por el controlador.
    // No se escriben manualmente las claves foráneas.
    const nodos = JSON.parse(
        document.getElementById('datosNodos').textContent
    );

    const versionSelect = document.getElementById('version');
    const origenSelect = document.getElementById('origen');
    const destinoSelect = document.getElementById('destino');

    function actualizarNodos() {
      const versionId = versionSelect.value;

      // Filtrar nodos según la versión seleccionada
      const disponibles = nodos.filter(
        nodo => String(nodo.version) === String(versionId)
      );

      origenSelect.innerHTML =
        '<option value="">Selecciona origen</option>';

      destinoSelect.innerHTML =
        '<option value="">Selecciona destino</option>';

      disponibles.forEach(nodo => {

        // Un nodo Fin no puede ser origen
        if (nodo.tipo !== 'fin') {
          origenSelect.add(
            new Option(nodo.nombre + ' (' + nodo.tipo + ')', nodo.id)
          );
        }

        // Un nodo Inicio no puede ser destino
        if (nodo.tipo !== 'inicio') {
          destinoSelect.add(
            new Option(nodo.nombre + ' (' + nodo.tipo + ')', nodo.id)
          );
        }
      });

      origenSelect.disabled = !versionId;
      destinoSelect.disabled = !versionId;
    }

    versionSelect.addEventListener('change', actualizarNodos);

    document.getElementById('formTransicion')
      .addEventListener('submit', async function (event) {

        event.preventDefault();

        const datos = {
          nombre: document.getElementById('nombre').value,
          version: versionSelect.value,
          origen: origenSelect.value,
          destino: destinoSelect.value
        };

        try {
          const token = document.querySelector('input[name="_csrf"]').value;
          const respuesta = await fetch('/admin/transiciones', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
                  'X-CSRF-Token': token

            },
            body: JSON.stringify(datos)
          });

          const texto = await respuesta.text();
          let resultado;

          try {
            resultado = JSON.parse(texto);
          } catch {
            alert('Error HTTP ' + respuesta.status);
            console.error(texto);
            return;
          }

          if (!respuesta.ok) {
            alert(resultado.error || 'No se pudo registrar');
            return;
          }

          alert(resultado.mensaje);
          window.location.reload();

        } catch (error) {
          console.error(error);
          alert('Error de comunicación con el servidor');
        }
      });
  </script>

</body>
</html>

