
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <title>Versiones | FlowForge</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">
</head>

<body class="bg-light">

  <%- include('partials/header', { paginaActual: '/admin/versiones' }) %>

<main class="container py-4">

    <section class="mb-5">

      <h2>Administración de versiones</h2>

      <p>
        Crea versiones en borrador de los procesos
        empresariales registrados en FlowForge.
      </p>

      <form id="formVersion" class="card p-4">
      <input type="hidden" name="_csrf" value="<%= _csrf %>">
        <div class="mb-3">
          <label for="proceso" class="form-label">
            Proceso
          </label>

          <select
            id="proceso"
            name="proceso"
            class="form-select"
            required>

            <option value="">
              Selecciona un proceso
            </option>

            <% procesos.forEach(function(proceso) { %>
              <option value="<%= proceso.id %>">
                <%= proceso.nombre %>
              </option>
            <% }); %>

          </select>
        </div>

        <div class="mb-3">
          <label for="numero" class="form-label">
            Número de versión
          </label>

          <input
            type="number"
            id="numero"
            name="numero"
            class="form-control"
            min="1"
            step="1"
            required>
        </div>

        <div class="mb-3">
          <label class="form-label">Estado inicial</label>
          <input
            class="form-control"
            value="Borrador"
            disabled>
        </div>

        <button type="submit" class="btn btn-primary">
          Crear versión
        </button>

      </form>

    </section>

    <section>
      <h2 class="h4 mb-3">Versiones registradas</h2>

      <div class="table-responsive">
        <table class="table table-striped">

          <thead>
            <tr>
              <th>ID</th>
              <th>Proceso</th>
              <th>Versión</th>
              <th>Estado</th>
              <th>Fecha de publicación</th>
            </tr>
          </thead>

          <tbody>
            <% versiones.forEach(function(version) { %>
              <tr>
                <td><%= version.id %></td>

                <td>
                  <%= version.proceso
                    ? version.proceso.nombre
                    : 'Sin proceso' %>
                </td>

                <td>v<%= version.numero %></td>

                <td>
                  <span class="badge bg-secondary">
                    <%= version.estado %>
                  </span>
                </td>

                <td>
                  <%= version.fechaPublicacion
                    ? new Date(version.fechaPublicacion)
                        .toLocaleDateString('es-EC')
                    : 'No publicada' %>
                </td>
              </tr>
            <% }); %>
          </tbody>

        </table>
      </div>
    </section>

  </main>

  <script>
    const formulario = document.getElementById('formVersion');

    formulario.addEventListener('submit', async function (event) {
      event.preventDefault();

      const datos = {
        proceso: document.getElementById('proceso').value,
        numero: document.getElementById('numero').value
      };

      try {
        const token = document.querySelector('input[name="_csrf"]').value;
        const respuesta = await fetch('/admin/versiones', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
                'X-CSRF-Token': token
          },
          body: JSON.stringify(datos)
        });

        const texto = await respuesta.text();

        let resultado;

        try {
          resultado = JSON.parse(texto);
        } catch {
          alert('Error HTTP ' + respuesta.status);
          console.error(texto);
          return;
        }

        if (!respuesta.ok) {
          alert(resultado.error || 'No se pudo crear la versión');
          return;
        }

        alert(resultado.mensaje);
        window.location.reload();

      } catch (error) {
        console.error(error);
        alert('No se pudo conectar con el servidor');
      }
    });
  </script>

</body>
</html>

