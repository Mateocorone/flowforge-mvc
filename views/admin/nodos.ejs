<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <title>Nodos | FlowForge</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">
</head>

<body class="bg-light">

  <%- include('partials/header', { paginaActual: '/admin/nodos' }) %>

<main class="container py-4">

    <section class="mb-5">

      <h2>Administración de nodos</h2>

      <p>
        Configura las etapas de cada versión
        de los procesos empresariales.
      </p>

      <form id="formNodo" class="card p-4">
        <input type="hidden" name="_csrf" value="<%= _csrf %>">
        <div class="mb-3">
          <label for="version" class="form-label">
            Versión del proceso
          </label>

          <select
            id="version"
            name="version"
            class="form-select"
            required>

            <option value="">
              Selecciona una versión
            </option>

            <% versiones.forEach(function(version) { %>
              <% if (version.estado === 'borrador') { %>
                <option value="<%= version.id %>">
                  <%= version.proceso.nombre %>
                  - v<%= version.numero %>
                </option>
              <% } %>
            <% }); %>

          </select>
        </div>

        <div class="mb-3">
          <label for="nombre" class="form-label">
            Nombre del nodo
          </label>

          <input
            id="nombre"
            name="nombre"
            class="form-control"
            maxlength="100"
            required>
        </div>

        <div class="mb-3">
          <label for="tipo" class="form-label">
            Tipo de nodo
          </label>

          <select
            id="tipo"
            name="tipo"
            class="form-select"
            required>

            <option value="">Selecciona un tipo</option>
            <option value="inicio">Inicio</option>
            <option value="condicion">Condición</option>
            <option value="aprobacion">Aprobación</option>
            <option value="fin">Fin</option>

          </select>
        </div>

        <button type="submit" class="btn btn-primary">
          Registrar nodo
        </button>

      </form>

    </section>

    <section>
      <h2 class="h4 mb-3">Nodos registrados</h2>

      <div class="table-responsive">

        <table class="table table-striped">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Tipo</th>
              <th>Versión</th>
              <th>Estado</th>
            </tr>
          </thead>

          <tbody>
            <% nodos.forEach(function(nodo) { %>
              <tr>
                <td><%= nodo.nombre %></td>

                <td>
                  <span class="badge bg-info text-dark">
                    <%= nodo.tipo %>
                  </span>
                </td>

                <td>
                  v<%= nodo.version.numero %>
                </td>

                <td>
                  Registrado
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>

      </div>
    </section>

  </main>

  <script>
    document.getElementById('formNodo')
      .addEventListener('submit', async function(event) {

        event.preventDefault();

        const datos = {
          version: document.getElementById('version').value,
          nombre: document.getElementById('nombre').value,
          tipo: document.getElementById('tipo').value
        };

        try {
          const token = document.querySelector('input[name="_csrf"]').value;
          const respuesta = await fetch('/admin/nodos', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
                  'X-CSRF-Token': token

            },
            body: JSON.stringify(datos)
          });

          const texto = await respuesta.text();

          let resultado;

          try {
            resultado = JSON.parse(texto);
          } catch {
            alert('Error HTTP ' + respuesta.status);
            console.error(texto);
            return;
          }

          if (!respuesta.ok) {
            alert(resultado.error || 'No se pudo registrar');
            return;
          }

          alert(resultado.mensaje);
          window.location.reload();

        } catch (error) {
          console.error(error);
          alert('Error al conectar con el servidor');
        }
      });
  </script>

</body>
</html>
