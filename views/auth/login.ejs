
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <title>Iniciar sesión | FlowForge</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">

  <style>
    body {
      min-height: 100vh;
      background: #f1f5f9;
    }

    .login-card {
      width: 100%;
      max-width: 420px;
    }
  </style>
</head>

<body class="d-flex align-items-center justify-content-center p-3">

  <main class="login-card">

    <section class="card shadow-sm border-0 p-4">

      <header class="text-center mb-4">
        <h1 class="text-primary fw-bold">FlowForge</h1>
        <p class="text-secondary mb-0">
          Administración de procesos empresariales
        </p>
      </header>

      <h2 class="h5 mb-4">Iniciar sesión</h2>

      <div id="mensaje"
           class="alert alert-danger d-none"
           role="alert"></div>

      <form id="formLogin">

        <div class="mb-3">
          <label for="email" class="form-label">
            Correo electrónico
          </label>

          <input
            type="email"
            id="email"
            class="form-control"
            autocomplete="username"
            required>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label">
            Contraseña
          </label>

          <input
            type="password"
            id="password"
            class="form-control"
            autocomplete="current-password"
            required>
        </div>

        <button id="btnIngresar"
                type="submit"
                class="btn btn-primary w-100">
          Ingresar
        </button>

      </form>

    </section>

  </main>

  <script>
    const formulario = document.getElementById('formLogin');
    const mensaje = document.getElementById('mensaje');
    const boton = document.getElementById('btnIngresar');

    formulario.addEventListener('submit', async function(event) {
      event.preventDefault();

      mensaje.classList.add('d-none');
      boton.disabled = true;
      boton.textContent = 'Verificando...';

      const datos = {
        email: document.getElementById('email').value,
        password: document.getElementById('password').value
      };

      try {
        const respuesta = await fetch('/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          credentials: 'same-origin',
          body: JSON.stringify(datos)
        });

        const texto = await respuesta.text();
        let resultado;

        try {
          resultado = JSON.parse(texto);
        } catch {
          throw new Error('Respuesta inesperada del servidor');
        }

        if (!respuesta.ok) {
          mensaje.textContent =
            resultado.error || 'No se pudo iniciar sesión';

          mensaje.classList.remove('d-none');
          return;
        }

        window.location.href = resultado.redireccion;

      } catch (error) {
        mensaje.textContent = error.message;
        mensaje.classList.remove('d-none');

      } finally {
        boton.disabled = false;
        boton.textContent = 'Ingresar';
      }
    });
  </script>

</body>
</html>
